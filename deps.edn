{:paths ["src"]

 ;; SPEC §3: ring-core, and Integrant only for the one optional namespace that
 ;; ships its key. Ring is the lingua franca — a handler, a request map, a
 ;; session map and a store protocol — and depending on anything more is how a
 ;; module stops being liftable. `structure_test.clj` enforces both halves by
 ;; reading every ns form under src/: what may be required at all, and which
 ;; single file may name Integrant.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ring/ring-core      {:mvn/version "1.15.5"}
        ;; SPEC §3 and §15: used, not imposed. Required only by
        ;; dev.arkaitz.auth-base.integrant, which ships one key's init-key —
        ;; and no halt-key!, because a ceremony owns nothing to close. Nothing
        ;; else may load it, and a scan enforces that, because an illegal
        ;; require compiles, loads and passes every other test. Added
        ;; 2026-09-22, when the first host asked for it; its whole closure,
        ;; integrant plus weavejester/dependency, reaches every consumer, and
        ;; that cost is what the dependency-closure test exists to keep visible.
        integrant/integrant {:mvn/version "1.0.1"}}

 :aliases
 {:test {:extra-paths ["test" "build" "harness/src" "harness/test" "demo/src" "demo/resources" "demo/test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ring/ring-mock                {:mvn/version "0.6.2"}
                       ring/ring-jetty-adapter       {:mvn/version "1.15.5"}
                       dev.arkaitz/web-base          {:mvn/version "0.2.0"}
                       io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       ;; The optional JDBC store's own test engines and the next.jdbc it
                       ;; requires — here and never in :deps: a host that wants that
                       ;; namespace brings next.jdbc itself (SPEC §14).
                       com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                       com.h2database/h2                 {:mvn/version "2.5.250"}
                       org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}}
         :main-opts   ["-m" "cognitect.test-runner" "-d" "test" "-d" "harness/test" "-d" "demo/test"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; SPEC §13: the harness runs on ring alone. A server has to come from
  ;; somewhere, so the adapter lives on this alias and never in :deps.
  :harness {:extra-paths ["harness/src"]
            :extra-deps  {ring/ring-jetty-adapter {:mvn/version "1.15.5"}}
            :main-opts   ["-m" "harness.main"]}

  ;; The integration probe: the same ceremony wired into web-base.
  :demo {:extra-paths ["demo/src" "demo/resources"]
         :extra-deps  {dev.arkaitz/web-base {:mvn/version "0.2.0"}}
         :main-opts   ["-m" "demo.main"]}

  :dev {:extra-paths ["dev" "harness/src" "demo/src" "demo/resources"]
        :extra-deps  {ring/ring-jetty-adapter {:mvn/version "1.15.5"}
                      dev.arkaitz/web-base    {:mvn/version "0.2.0"}}}

  ;; `build` carries the release guards, which are tested — hence also on :test.
  ;; It is not in :paths, so like demo/ and harness/ it never enters the jar.
  :build {:extra-paths ["build"]
          :deps        {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                        slipset/deps-deploy           {:mvn/version "0.2.5"}}
          :ns-default  build}}}
